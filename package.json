{
  "name": "jude-study-room-desktop",
  "version": "0.6.0",
  "private": true,
  "description": "A personal GED classroom for Jude and his tutor",
  "author": "Jude\u2019s Study Room",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac zip --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "test": "node --test tests/*.test.cjs",
    "content:prepare": "node scripts/content-manifest.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.judestudyroom.desktop",
    "productName": "Jude Study Room",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "ui/**",
      "package.json",
      "content-manifest.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "identity": null,
      "target": [
        "zip"
      ],
      "icon": "build/icon.icns",
      "publish": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "Jude-Study-Room-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "RobloxCreator-sketch",
        "repo": "jude-study-room",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RobloxCreator-sketch/jude-study-room.git"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "semver": "7.7.4"
  }
}
